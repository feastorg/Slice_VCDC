	(text "VDD may be 3V3 or 5V"
		(exclude_from_sim no)
		(at 251.968 74.676 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "0d27ddd6-0243-48fc-8c7e-e2a16aaa31da")
	)
	(text "// Given:\nV_dc_max     = 400.0   // Max DC link voltage (V)\nV_fsr        = 2.0     // AMC1311 full-scale input voltage (V)\nV_res_max    = 75.0    // Max voltage per unit resistor (V)\nI_cross_max  = 100e-6  // Max divider current (A)\n\n// Divider total resistance (Ohm):\nR_total = V_dc_max / I_cross_max = 4_000_000 Ω\n\n// Minimum unit resistors needed:\nn_units = ceil(V_dc_max / V_res_max) = 6\n\n// Choose nearest E96 value:\nR_unit = 665_000 Ω\nR_top  = n_units * R_unit = 3_990_000 Ω\n\n// Sense resistor to get 2V at 400V input:\nR_sns = (V_fsr / (V_dc_max - V_fsr)) * R_top\n      = (2 / (400 - 2)) * 3_990_000 ≈ 20_050 Ω\n\n// Resulting:\nI_cross = V_dc_max / (R_top + R_sns) ≈ 99.7 µA\nP_unit  = V_res_max^2 / R_unit ≈ 6.6 mW\nP_total ≈ V_dc_max * I_cross ≈ 39.9 mW\n\n// Therefore:\n- six 665 kΩ resistors in series (top leg)\n- 20.05 kΩ resistor for RSNS (bottom leg)\n"
		(exclude_from_sim no)
		(at 24.638 124.968 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "0f2d3432-3a1c-4ddd-825a-dc70f5d5a38b")
	)
	(text "// ========================================\n// Alternate Bus Voltage Design Cases (Fixed 6 Resistors)\n// ========================================\n// Note: The original 400 V case is the maximum supported \n// configuration and is shown previously in detail.\n// For all other lower voltage cases, we maintain  the same layout,\n// 6 unit resistors, and adjust their values so that voltage drop \n// is distributed equally, and thermal dissipation remains balanced.\n\n// Formula recap:\n//   R_total = V_dc_max / I_cross_max\n//   R_unit  = R_top / 6\n//   R_sns   = (V_fsr / (V_dc_max - V_fsr)) * R_top\n\n// ---------- 300V DC Bus ----------\nV_dc_max = 300.0\nR_total  = 3_000_000\nR_unit   = 499_000 Ω (E96)\nR_top    = 6 × 499_000 = 2_994_000 Ω\nR_sns    = (2 / (300 - 2)) * 2_994_000 ≈ 20_134 Ω\n\n// Therefore:\n// - six 499 kΩ resistors (top leg)\n// - 20.1 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 250V DC Bus ----------\nV_dc_max = 250.0\nR_total  = 2_500_000\nR_unit   = 412_000 Ω (E96)\nR_top    = 6 × 412_000 = 2_472_000 Ω\nR_sns    = (2 / (250 - 2)) * 2_472_000 ≈ 20_161 Ω\n\n// Therefore:\n// - six 412 kΩ resistors (top leg)\n// - 20.2 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 200V DC Bus ----------\nV_dc_max = 200.0\nR_total  = 2_000_000\nR_unit   = 332_000 Ω (E96)\nR_top    = 6 × 332_000 = 1_992_000 Ω\nR_sns    = (2 / (200 - 2)) * 1_992_000 ≈ 20_151 Ω\n\n// Therefore:\n// - six 332 kΩ resistors (top leg)\n// - 20.2 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 150V DC Bus ----------\nV_dc_max = 150.0\nR_total  = 1_500_000\nR_unit   = 249_000 Ω (E96)\nR_top    = 6 × 249_000 = 1_494_000 Ω\nR_sns    = (2 / (150 - 2)) * 1_494_000 ≈ 20_270 Ω\n\n// Therefore:\n// - six 249 kΩ resistors (top leg)\n// - 20.3 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 100V DC Bus ----------\nV_dc_max = 100.0\nR_total  = 1_000_000\nR_unit   = 165_000 Ω (E96)\nR_top    = 6 × 165_000 = 990_000 Ω\nR_sns    = (2 / (100 - 2)) * 990_000 ≈ 20_204 Ω\n\n// Therefore:\n// - six 165 kΩ resistors (top leg)\n// - 20.2 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 48V DC Bus ----------\nV_dc_max = 48.0\nR_total  = 480_000\nR_unit   = 78.7 kΩ (E96)\nR_top    = 6 × 78_700 = 472_200 Ω\nR_sns    = (2 / (48 - 2)) * 472_200 ≈ 20_460 Ω\n\n// Therefore:\n// - six 78.7 kΩ resistors (top leg)\n// - 20.5 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 24V DC Bus ----------\nV_dc_max = 24.0\nR_total  = 240_000\nR_unit   = 39.2 kΩ (E96)\nR_top    = 6 × 39_200 = 235_200 Ω\nR_sns    = (2 / (24 - 2)) * 235_200 ≈ 21_380 Ω\n\n// Therefore:\n// - six 39.2 kΩ resistors (top leg)\n// - 21.4 kΩ resistor for RSNS (bottom leg)\n\n// ---------- 12V DC Bus ----------\nV_dc_max = 12.0\nR_total  = 120_000\nR_unit   = 19.6 kΩ (E96)\nR_top    = 6 × 19_600 = 117_600 Ω\nR_sns    = (2 / (12 - 2)) * 117_600 ≈ 23_520 Ω\n\n// Therefore:\n// - six 19.6 kΩ resistors (top leg)\n// - 23.5 kΩ resistor for RSNS (bottom leg)\n"
		(exclude_from_sim no)
		(at -49.022 131.064 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "10cbed29-96f9-4cbc-a11f-39b102a04540")
	)
	(text "∧\n|\n|\n|\n2V\n|\n|\n|\n∨"
		(exclude_from_sim no)
		(at 212.852 90.678 0)
		(effects
